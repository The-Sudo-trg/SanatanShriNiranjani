# Database
DATABASE_URL="file:./dev.db"

# Production database (ADR-002 — Turso/libSQL on Vercel; ignored by local dev).
# When TURSO_DATABASE_URL is set, lib/prisma-create.ts uses the libSQL driver
# adapter and `npm run build` runs scripts/db-sync-schema.mjs first to apply the
# additive schema (CREATE TABLE / ADD COLUMN, idempotent) to the hosted DB.
# TURSO_DATABASE_URL="libsql://<db>-<org>.turso.io"
# TURSO_AUTH_TOKEN=""

# AI (server-side only, never exposed to client)
# z-ai-web-dev-sdk reads its own auth config; do not commit real keys.

# App
NEXT_PUBLIC_APP_NAME="सनातन श्री निरंजनी"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth (Day 1) — HMAC-SHA256 session JWT signing key.
# REQUIRED in production (min 16 chars; auth fails closed without it).
# Dev/test fall back to a built-in unstable secret, so you may leave it empty locally.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Seed ADMIN (local dev only) — NO working default password is committed.
# Leave SEED_ADMIN_PASSWORD empty and `npm run db:seed` generates a strong random
# password, prints it once, and stores only its scrypt hash.
SEED_ADMIN_EMAIL="admin@niranjani.local"
SEED_ADMIN_PASSWORD=""

# Payments (v2 — keep mocked in v1)
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
